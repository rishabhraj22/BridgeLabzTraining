-- Return Book and Calculate Fine (Assume 10 days late, fine = 10 * 5 = 50)
UPDATE borrow_records
SET return_date = DATE_ADD(borrow_date, INTERVAL 10 DAY),
    fine = 50,
    status = 'RETURNED'
WHERE record_id = 1;

UPDATE books
SET available_copies = available_copies + 1
WHERE book_id = 1;

